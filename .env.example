# Public address of this website (no trailing slash). Used for canonical URLs,
# the sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.askmira.com

# Where "Sign in" goes: the AskMira portal (../frontend).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The AskMira API that stores demo requests (POST /api/v1/public/demo-requests).
# Read on the server only; the browser never calls the API.
ASKMIRA_API_BASE=http://localhost:8000

# Optional. The same PROXY_SHARED_SECRET the API is configured with. When set,
# the visitor's address is forwarded so the API's per-address rate limit
# applies per visitor rather than to this server as a whole.
PROXY_SHARED_SECRET=
